<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The test APK is an app of its own, with its own UID. A SOCKS proxy runs in its process, as a
         separate proxy app (v2rayNG and the like) does for NetStrazh: see OtherAppProxy. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <service
            android:name="lab.netstrazh.OtherAppProxy"
            android:exported="true"
            android:process=":proxy" />
    </application>
</manifest>
